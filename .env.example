# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# Note: every variable here is exported into the runtime, and the runtime snapshots its
# environment into `.home/<profile>/shell_snapshots/`. Your key therefore ends up on disk in
# plaintext there as well as in `.env`. Both paths are gitignored, but delete `.home/` before
# sharing or archiving this directory.
#
# Consumed by ./run.sh, which does `set -a; . .env; set +a` -- i.e. this file is *sourced as
# shell*, not parsed as a properties file. So:
#   * no spaces around `=`
#   * quote any value containing spaces, `#`, or shell metacharacters
#   * every variable set here is exported to the child process
#
# None of this is needed to run a PoA package (`poas/`) or demos 0 and 6-9: those never sample
# a model, and run.sh substitutes placeholders for them. Fill it in when you get to the demos
# that spawn subagents (01-05, 10).

# --- required by the agent-spawning demos ----------------------------------------------

# Provider base URL, with or without a trailing /v1 (run.sh appends it if missing; the runtime
# then appends /responses itself).
# NOTE: the demo profiles pin `wire_api = "responses"` (config/*.toml), so the provider must
# speak the Responses API. A chat-completions-only endpoint will not work.
OPENAI_API_URL=https://api.openai.com/v1

# Forwarded to the runtime as the provider's `env_key`; never commit the real value.
OPENAI_API_KEY=sk-replace-me

# Default model. After changing it, re-run demos/00_probe.js -- the multi-agent backend is
# chosen by model metadata, not by local config (see README, "Backend selection").
OPENAI_API_MODEL=gpt-5

# --- optional overrides ---------------------------------------------------------------

# Path to the `codex` binary. Resolution order is CODEX_BIN > ./bin/codex > PATH.
# Set this if you keep the runtime somewhere other than ./bin. `codex` locates
# `codex-code-mode-host` in its own directory, so the two must sit together.
#CODEX_BIN=/absolute/path/to/codex

# Wire protocol: `responses` (default) or `anthropic`.
#WIRE_API=responses

# Override the model / base URL for demo runs only, leaving the vars above untouched.
#CODEX_DEMO_MODEL=
#CODEX_DEMO_BASE_URL=
#CODEX_DEMO_WIRE_API=

# sandbox_mode for the spawned thread; defaults to read-only. Demo 8 needs workspace-write.
#CODEX_DEMO_SANDBOX=read-only
